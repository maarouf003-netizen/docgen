{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/logs-.txt",
      "RetainedDays": 60,
      "FileSizeLimitBytes": 52428800,
      "ClientErrorPerMinuteLimit": 30,
      "ClientErrorPayloadSizeLimit": 2048,
      "ClientErrorStackLimit": 8192
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=docgen.db"
  },
  "Database": {
    "UsePostgres": false,
    // الإنتاج: لا ترحيل تلقائي عند الإقلاع — تُطبَّق الهجرات صراحةً قبل تشغيل النسخة
    // (انظر RUN_GUIDE.md §9). التطبيق يرفض الإقلاع إن كان المخطط غير مطابق.
    "AutoMigrate": false
  },
  "HeadAlerts": {
    "Outbox": {
      // مشغّل تسليم التنبيهات النظامية. Enabled=false يوقف المعالجة (تُسجَّل
      // الرسائل وتتراكم) — أوقفه قبل أي عملية يدوية على جدول Outbox.
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "LeaseDurationMinutes": 2,
      "MaxAttempts": 10,
      "ProcessedRetentionDays": 7,
      "SkippedRetentionDays": 30
    },
    "LegacyBridge": {
      // الجسر الانتقالي للصفوف legacy — مغلق افتراضيًا، ويُفعَّل بقرار بوابة G0
      // على بيانات الإنتاج فقط (docs/audit/06-head-alert-g0-20261020.md).
      "Enabled": false
    }
  },
  "TimeZone": {
    "Id": "Asia/Damascus"
  },
  "Security": {
    "KnownProxies": [],
    "HstsEnabled": false,
    "HttpsRedirectionEnabled": false,
    "CspReportOnly": true
  },
  "Export": {
    "MaxRows": 10000
  },
  "Forum": {
    "RetentionMonths": 6
  },
  "RateLimiting": {
    "MaxLoginAttempts": 5,
    "WindowMinutes": 5,
    "LoginIpPerMinute": 10,
    "GeneralAnonPerMinute": 100,
    "GeneralAuthPerMinute": 300,
    "ExpensivePerMinute": 60,
    "PasswordPerMinute": 5
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "MaxLockoutMinutes": 120
  },
  "Swagger": {
    "Enabled": false
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "DocGenerator",
    "Audience": "DocGeneratorClients",
    "ExpiryMinutes": 240
  },
  "WordTemplates": {
    "Path": "WordTemplates",
    "Templates": {
      "001": "summon.docx",
      "002": "record.docx",
      "003": "notice.docx",
      "004": "Seizure.docx",
      "005": "property.docx",
      "006": "property notice via paper.docx",
      "007": "notice via paper.docx",
      "PS": "property seizure.docx"
    }
  }
}
