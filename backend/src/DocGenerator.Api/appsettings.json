{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/logs-.txt",
      "RetainedDays": 60,
      "FileSizeLimitBytes": 52428800,
      "ClientErrorPerMinuteLimit": 30,
      "ClientErrorPayloadSizeLimit": 2048,
      "ClientErrorStackLimit": 8192
    }
  },
  "AllowedHosts": "*",
  "Database": {
    // ADR-0001: PostgreSQL فقط. سلسلة الاتصال تُحقن عبر DATABASE_URL أو
    // ConnectionStrings__DefaultConnection، ولا قيمة افتراضية لـSQLite في المستودع.
    // الإنتاج: لا ترحيل تلقائي عند الإقلاع — تُطبَّق الهجرات صراحةً قبل تشغيل النسخة
    // (انظر RUN_GUIDE.md §9). التطبيق يرفض الإقلاع إن كان المخطط غير مطابق.
    "AutoMigrate": false,
    // P0-03: إعادة المحاولة معطّلة افتراضيًا. التفعيل آمن فقط للعمليات القابلة
    // لإعادة المحاولة بعد P0-03b؛ SaveChanges داخل معاملة لا يُعاد أبدًا.
    "RetryMaxCount": 0,
    "RetryMaxDelaySeconds": 30
  },
  "HeadAlerts": {
    "Outbox": {
      // مشغّل تسليم التنبيهات النظامية. Enabled=false يوقف المعالجة (تُسجَّل
      // الرسائل وتتراكم) — أوقفه قبل أي عملية يدوية على جدول Outbox.
      "Enabled": true,
      "PollIntervalSeconds": 2,
      "LeaseDurationMinutes": 2,
      "MaxAttempts": 10,
      "ProcessedRetentionDays": 7,
      "SkippedRetentionDays": 30
    }
  },
  "TimeZone": {
    "Id": "Asia/Damascus"
  },
  "Security": {
    "KnownProxies": [],
    "HstsEnabled": false,
    // المدة بالأيام؛ preload مستقل عمدًا ولا يُفعَّل إلا على النطاق النهائي بعد سنة HTTPS كاملة.
    "HstsMaxAgeDays": 365,
    "HstsPreload": false,
    "HttpsRedirectionEnabled": false,
    "CspReportOnly": true,
    // تشغيل بيئة Development يشترط راية صريحة من launchSettings/user-secrets/متغير بيئة
    // (لا تُضبط هنا ولا في appsettings.Development.json: كلتاهما تُقرأ في البيئة نفسها).
    "AllowDevelopmentEnvironment": false
  },
  "Export": {
    "MaxRows": 10000
  },
  "Forum": {
    "RetentionMonths": 6
  },
  "RateLimiting": {
    "MaxLoginAttempts": 5,
    "WindowMinutes": 5,
    "LoginIpPerMinute": 10,
    "GeneralAnonPerMinute": 100,
    "GeneralAuthPerMinute": 300,
    "ExpensivePerMinute": 60,
    "PasswordPerMinute": 5,
    "CspReportPerMinute": 60
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "MaxLockoutMinutes": 120
  },
  "Swagger": {
    "Enabled": false
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "DocGenerator",
    "Audience": "DocGeneratorClients",
    "ExpiryMinutes": 240
  },
  "DocumentGeneration": {
    "Enabled": false,
    "DisabledMessage": "الميزة معطلة حاليًا لحين توحيد النماذج المولدة"
  },
  "WordTemplates": {
    "Path": "WordTemplates",
    "Templates": {
      "001": "summon.docx",
      "002": "record.docx",
      "003": "notice.docx",
      "004": "Seizure.docx",
      "005": "property.docx",
      "006": "property notice via paper.docx",
      "007": "notice via paper.docx",
      "PS": "property seizure.docx"
    }
  }
}
