{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Path": "logs/logs-.txt",
      "RetainedDays": 31,
      "FileSizeLimitBytes": 52428800,
      "ClientErrorPerMinuteLimit": 30,
      "ClientErrorPayloadSizeLimit": 2048,
      "ClientErrorStackLimit": 8192
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=docgen.db"
  },
  "Database": {
    "UsePostgres": false
  },
  "Security": {
    "KnownProxies": []
  },
  "Export": {
    "MaxRows": 10000
  },
  "RateLimiting": {
    "MaxLoginAttempts": 5,
    "WindowMinutes": 5
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Swagger": {
    "Enabled": false
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "DocGenerator",
    "Audience": "DocGeneratorClients",
    "ExpiryMinutes": 480
  },
  "WordTemplates": {
    "Path": "WordTemplates",
    "Templates": {
      "001": "summon.docx",
      "002": "record.docx",
      "003": "notice.docx",
      "004": "Seizure.docx",
      "005": "property.docx",
      "006": "property notice via paper.docx",
      "007": "notice via paper.docx",
      "PS": "property seizure.docx"
    }
  }
}
