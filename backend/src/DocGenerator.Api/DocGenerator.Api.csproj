<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>d5c3a4e2-9b1f-4c8e-9a6d-7f2e1b3c4d5e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocGenerator.Application\DocGenerator.Application.csproj" />
    <ProjectReference Include="..\DocGenerator.Infrastructure\DocGenerator.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="WordTemplates\**\*.docx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
