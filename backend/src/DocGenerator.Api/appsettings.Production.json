{
  // P6-01b: في الإنتاج تُخزَّن مفاتيح Data Protection في PostgreSQL
  // (جدول DataProtectionKeys) فتبقى صلاحية حماية الحمولات (مثل مفاتيح التشفير
  // المستقبلية) بعد النشر/إعادة التشغيل.
  // ملاحظة مهمة (W2/F15): جلسة الدخول JWT موقّعة بـ`Jwt:Secret` ولا تستخدم
  // Data Protection إطلاقًا — بقاء المفاتيح لا يُبقي جلسات المستخدمين بعد النشر،
  // بل تبقى الجلسة ما دام `Jwt:Secret` نفسه والرمز لم ينتهِ/يُبطَل.
  // يجب تطبيق هجرة AddDataProtectionKeys قبل تشغيل النسخة (AutoMigrate=false).
  "DataProtection": {
    "PersistToDatabase": true
  }
}
