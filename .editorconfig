# P4-06 — تنسيق موحّد وبوابة `dotnet format --verify-no-changes` (CI: backend).
# القاعدة: الملفات المولّدة/الهجرات تُستثنى من التنسيق اليدوي.
#
# P4-06d — تقييم Roslynator/StyleCop انتهى إلى **التأجيل** بدليل مقيس
# (docs/audit/252): لا تُضف `dotnet_diagnostic.<RCS|SA|SX>.severity` هنا قبل أن
# تشير المشاريع إلى حزمة المحلّل؛ الإعداد بلا حزمة لا يفحص شيئًا (خضرة كاذبة)،
# ويحرس ذلك `AnalyzerConfigurationTests` في DocGenerator.Architecture.Tests.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csproj,props,targets,sln}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[backend/src/DocGenerator.Infrastructure/Persistence/Migrations*/**]
indent_size = 4
generated_code = true
