  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "1 - (5xx / all API responses) over 30 days. Target: >= 99.5%. Health, metrics and SPA/static requests are excluded by http_route=~\"/api/.*\".",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.995 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=\"docgen-api\",http_route=~\"/api/.*\",http_response_status_code=~\"[1-4][0-9][0-9]\"}[30d])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_name=\"docgen-api\",http_route=~\"/api/.*\",http_response_status_code=~\"[1-5][0-9][0-9]\"}[30d])), 0.001)",
          "instant": true,
          "legendFormat": "availability 30d",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Availability (SLO-1, 30d)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "API request rate by matched route. Excludes health probes.",
